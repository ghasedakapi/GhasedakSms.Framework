<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net40;net47;net48</TargetFrameworks>
		<RootNamespace>GhasedakSms.Framework</RootNamespace>
		<AssemblyName>GhasedakSms.Framework</AssemblyName>
		<LangVersion>7.3</LangVersion>
		<Nullable>disable</Nullable>

		<!-- NuGet package metadata -->
		<PackageId>GhasedakSms.Framework</PackageId>
		<Version>1.0.7</Version>
		<Title>GhasedakSms.Framework</Title>
		<Authors>Amir Keshtkar</Authors>
		<Description>A cross platform integration library to send request on new Ghasedak Sms webservice</Description>
		<PackageTags>Ghasedak Sms</PackageTags>
		<PackageProjectUrl>https://github.com/ghasedakapi/GhasedakSms.Framework</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageIcon>ghasedak.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Added support for .NET 4.0 and .NET 4.8 via multi-targeting.</PackageReleaseNotes>
		<Copyright>Amir Keshtkar</Copyright>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<!-- Suppress auto-generated AssemblyInfo — the project still has Properties/AssemblyInfo.cs from the old-style format -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<!-- Package icon and readme (included in NuGet package) -->
	<ItemGroup>
		<None Include="ghasedak.png" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- ===== .NET 4.0 dependencies ===== -->
	<!-- net40 needs Newtonsoft.Json (System.Text.Json doesn't support net40) -->
	<!-- and Microsoft.Bcl packages for async/await + HttpClient -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net40'">
		<Reference Include="System" />
		<Reference Include="System.Core" />
		<Reference Include="System.Net.Http" />
		<Reference Include="System.Web" />
		<Reference Include="System.Xml" />

		<PackageReference Include="Microsoft.Bcl" Version="1.1.10">
			<ExcludeAssets>build</ExcludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Bcl.Async" Version="1.0.168">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Net.Http" Version="2.2.29">
			<ExcludeAssets>build</ExcludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<!-- ===== .NET 4.7 dependencies ===== -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net47'">
		<Reference Include="System" />
		<Reference Include="System.Core" />
		<Reference Include="System.Net.Http" />
		<Reference Include="System.Web" />
		<Reference Include="System.Xml" />

		<PackageReference Include="System.Text.Json" Version="8.0.4" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
	</ItemGroup>

	<!-- ===== .NET 4.8 dependencies ===== -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Reference Include="System" />
		<Reference Include="System.Core" />
		<Reference Include="System.Net.Http" />
		<Reference Include="System.Web" />
		<Reference Include="System.Xml" />

		<PackageReference Include="System.Text.Json" Version="8.0.4" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
	</ItemGroup>

</Project>
